# ─────────────────────────────────────────────────
# CipherLink — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file with real secrets
# ─────────────────────────────────────────────────

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cipherlink:cipherlink_secret@postgres:5432/cipherlink
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT / Auth ───────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption ───────────────────────────────────
ENCRYPTION_MASTER_KEY=CHANGE_ME_TO_A_64_CHAR_HEX_MASTER_KEY

# ── AWS S3 (optional, for production) ────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=cipherlink-storage

# ── Azure Blob (optional, future) ────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=cipherlink

# ── Local Storage (development) ──────────────────
LOCAL_STORAGE_PATH=/app/storage

# ── Application ──────────────────────────────────
APP_NAME=CipherLink
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ── CORS ─────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]

# ── Rate Limiting ────────────────────────────────
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=100/minute
RATE_LIMIT_ENCRYPTION=50/minute
